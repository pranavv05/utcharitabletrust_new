# Copy to .env.local and set your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side migration/backup scripts only. Never use NEXT_PUBLIC_ for this.
DATABASE_URL=
# Set PGSSLROOTCERT to a trusted CA file when running database scripts.

# Optional general AI replies. Keep this key server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Cloudflare Turnstile CAPTCHA for the contact and membership forms.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile. The secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional salt used when hashing visitor addresses for rate limiting.
RATE_LIMIT_SALT=
