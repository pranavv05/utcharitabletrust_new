# Copy to .env.local and set your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side migration/backup scripts only. Never use NEXT_PUBLIC_ for this.
DATABASE_URL=
# Set PGSSLROOTCERT to a trusted CA file when running database scripts.

# Optional general AI replies. Keep this key server-side.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
